<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework / Nullable / ImplicitUsings come from Directory.Build.props. -->

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <!-- Daily budgets outlive the process, so they need a file. SQLite rather
         than a JSON file because concurrent proxies must check-and-charge
         atomically, and a database transaction is that primitive for free. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <!-- JWT access-token validation for 'access.oauth'. Signature checking is
         security-critical code best left to the library every ASP.NET Core JWT
         bearer handler is built on, and a trimmed Native AOT publish with it
         has no warnings. JWKS fetching, caching and the claim checks stay in
         this repository (Access/), where they are unit-tested. -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The policy packs ship inside the binary, so init works from a single
         Native AOT executable with nothing beside it. Their test files are for
         CI and stay out. -->
    <EmbeddedResource Include="..\..\packs\*.yaml" Exclude="..\..\packs\*.test.yaml" LogicalName="packs/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- A wildcard that matches nothing is not an error to MSBuild, so a build
       context missing packs/ (a Dockerfile that copies only src/, say) would
       quietly produce a binary whose init has nothing to offer. -->
  <Target Name="RequirePolicyPacks" BeforeTargets="CoreCompile">
    <Error Condition="'@(EmbeddedResource->WithMetadataValue('Extension', '.yaml'))' == ''"
           Text="No policy packs found in packs/. The packs are compiled into the binary; copy the packs folder into the build." />
  </Target>

  <ItemGroup>
    <!-- Lets tests reach internal members (e.g. the stdio transport factory)
         without widening the public API surface just to make it testable. -->
    <InternalsVisibleTo Include="McpGuardrails.Core.Tests" />
  </ItemGroup>

</Project>
