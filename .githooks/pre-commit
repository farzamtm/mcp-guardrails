#!/usr/bin/env bash
#
# main is not a workspace.
#
# GitHub's branch protection (.github/rulesets/main.json) refuses direct pushes
# to main on the server. This catches the same mistake earlier, on your
# machine: starting work, forgetting to branch, and noticing three commits
# later - before there is anything to untangle.
#
# Enable with:  git config core.hooksPath .githooks
set -euo pipefail

branch="$(git symbolic-ref --quiet --short HEAD || echo '')"

case "$branch" in
  main|master)
    cat >&2 <<EOF

  ✗ refusing to commit directly to '$branch'.

    Every change belongs on its own branch (CONTRIBUTING.md):

        git switch -c feat/<short-description>

    Your staged changes are untouched - move them with:

        git stash && git switch -c feat/<short-description> && git stash pop

    Deliberate exception: git commit --no-verify

EOF
    exit 1
    ;;
esac

# A detached HEAD is not a branch either, and a commit made there is a commit
# you will lose.
if [ -z "$branch" ]; then
  cat >&2 <<'EOF'

  ✗ HEAD is detached - this commit would not belong to any branch.

    git switch -c feat/<short-description>

EOF
  exit 1
fi

exit 0
